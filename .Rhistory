ls()
library(tidyverse)
library(here)
data2 <- readRDS(here("R Code and Data", "Cty_Agg.rds"))
data2 |>
filter(!is.na(fed_share_pct), !is.na(R_Tax), !is.na(population), population > 0) |>
mutate(tax_per_capita = (R_Tax * 1000) / population) |>
ggplot(aes(x = fed_share_pct, y = tax_per_capita)) +
geom_point(alpha = 0.6) +
labs(
x = "Federal Land (%)",
y = "Total Tax Revenue per Capita ($)",
title = "County Tax Revenue per Capita vs. Federal Land Share",
subtitle = "Western U.S. counties, 2012"
)
names(data2)
data2 |> count(metro)
data2 |>
filter(metro == "Non-Metro", !is.na(fed_share_pct), !is.na(R_Tax), !is.na(population), population > 0) |>
mutate(tax_per_capita = (R_Tax * 1000) / population) |>
ggplot(aes(x = fed_share_pct, y = tax_per_capita)) +
geom_point(alpha = 0.6) +
labs(
x = "Federal Land (%)",
y = "Total Tax Revenue per Capita ($)",
title = "County Tax Revenue per Capita vs. Federal Land Share",
subtitle = "Non-metro western U.S. counties, 2012"
)
data2 |>
filter(!is.na(R_IG_Fed), !is.na(Total_Revenue), Total_Revenue > 0,
!is.na(PerCap_TaxBurden)) |>
mutate(fed_igr_share = R_IG_Fed / Total_Revenue) |>
ggplot(aes(x = fed_igr_share, y = PerCap_TaxBurden)) +
geom_point(alpha = 0.6) +
scale_x_continuous(labels = scales::percent_format()) +
labs(
x = "Federal IGR / Total Revenue",
y = "Tax Revenue per Capita ($)",
title = "Per Capita Tax Revenue vs. Federal Intergovernmental Revenue Share",
subtitle = "Western U.S. counties, 2012"
)
data2 |>
filter(metro == "Non-Metro",
!is.na(R_IG_Fed), !is.na(Total_Revenue), Total_Revenue > 0,
!is.na(PerCap_TaxBurden)) |>
mutate(fed_igr_share = R_IG_Fed / Total_Revenue) |>
ggplot(aes(x = fed_igr_share, y = PerCap_TaxBurden)) +
geom_point(alpha = 0.6) +
scale_x_continuous(labels = scales::percent_format()) +
labs(
x = "Federal IGR / Total Revenue",
y = "Tax Revenue per Capita ($)",
title = "Per Capita Tax Revenue vs. Federal Intergovernmental Revenue Share",
subtitle = "Non-metro western U.S. counties, 2012"
)
library(broom)
reg_data <- data2 |>
filter(metro == "Non-Metro",
!is.na(R_IG_Fed), !is.na(Total_Revenue), Total_Revenue > 0,
!is.na(PerCap_TaxBurden), !is.na(fed_share_pct)) |>
mutate(fed_igr_share = R_IG_Fed / Total_Revenue)
m1 <- lm(PerCap_TaxBurden ~ fed_igr_share + fed_share_pct, data = reg_data)
tidy(m1, conf.int = TRUE) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
glance(m1) |>
select(r.squared, adj.r.squared, sigma, nobs) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
par(mfrow = c(1, 2))
plot(m1, which = c(1, 2))
m2 <- lm(log(PerCap_TaxBurden) ~ fed_igr_share + fed_share_pct, data = reg_data)
tidy(m2, conf.int = TRUE) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
glance(m2) |>
select(r.squared, adj.r.squared, sigma, nobs) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
par(mfrow = c(1, 2))
plot(m2, which = c(1, 2))
library(broom)
# State fixed effects only (common slope for fed_igr_share)
m3 <- lm(log(PerCap_TaxBurden) ~ fed_igr_share + fed_share_pct + state_name,
data = reg_data)
# State FE + interaction (slope allowed to vary by state)
m4 <- lm(log(PerCap_TaxBurden) ~ fed_share_pct + state_name * fed_igr_share,
data = reg_data)
# F-test: does allowing slopes to vary improve fit?
anova(m3, m4)
# State FE model summary
glance(m3) |>
select(r.squared, adj.r.squared, sigma, nobs) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
tidy(m3, conf.int = TRUE) |>
filter(!str_starts(term, "state_name")) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
# State intercept shifts (relative to Arizona as baseline)
tidy(m3, conf.int = TRUE) |>
filter(str_starts(term, "state_name")) |>
mutate(
state = str_remove(term, "state_name"),
across(where(is.numeric), \(x) round(x, 3))
) |>
select(state, estimate, std.error, p.value, conf.low, conf.high)
# Visualize: scatter by state with a common fitted slope
aug <- augment(m3, data = reg_data)
ggplot(aug, aes(x = fed_igr_share, y = log(PerCap_TaxBurden))) +
geom_point(alpha = 0.5, size = 1.2) +
geom_line(aes(y = .fitted), color = "steelblue", linewidth = 0.8) +
facet_wrap(~ state_name, ncol = 4) +
scale_x_continuous(labels = scales::percent_format()) +
labs(
x = "Federal IGR / Total Revenue",
y = "log(Tax Revenue per Capita)",
title = "Per Capita Tax Revenue vs. Federal IGR Share by State",
subtitle = "State fixed effects model — common slope, state-specific intercepts"
)
m5 <- lm(log(PerCap_TaxBurden) ~ fed_igr_share + fed_share_pct + log(population) + state_name,
data = reg_data)
tidy(m5, conf.int = TRUE) |>
filter(!str_starts(term, "state_name")) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
glance(m5) |>
select(r.squared, adj.r.squared, sigma, nobs) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
summary(reg_data$fed_share_pct)
quantile(reg_data$fed_share_pct, probs = c(0.25, 0.5, 0.75))
# Continuous interaction
m6 <- lm(log(PerCap_TaxBurden) ~ fed_igr_share * fed_share_pct + log(population) + state_name,
data = reg_data)
tidy(m6, conf.int = TRUE) |>
filter(!str_starts(term, "state_name")) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
glance(m6) |>
select(r.squared, adj.r.squared, sigma, nobs) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
# Median-split for visualization
reg_data_split <- reg_data |>
mutate(fed_land_group = if_else(fed_share_pct >= median(fed_share_pct),
"High Fed Land (≥36%)",
"Low Fed Land (<36%)"))
ggplot(reg_data_split, aes(x = fed_igr_share, y = log(PerCap_TaxBurden),
color = fed_land_group)) +
geom_point(alpha = 0.4, size = 1.5) +
geom_smooth(method = "lm", se = TRUE) +
scale_x_continuous(labels = scales::percent_format()) +
labs(
x = "Federal IGR / Total Revenue",
y = "log(Tax Revenue per Capita)",
color = NULL,
title = "Federal IGR Effect on Tax Revenue by Federal Land Share Group",
subtitle = "Non-metro western U.S. counties, 2012"
) +
theme(legend.position = "bottom")
summary(reg_data$n_govts)
# Add log(n_govts) as main effect first
m7 <- lm(log(PerCap_TaxBurden) ~ fed_igr_share + fed_share_pct + log(population) +
log(n_govts) + state_name,
data = reg_data)
# With interaction
m8 <- lm(log(PerCap_TaxBurden) ~ fed_share_pct + log(population) + log(n_govts) +
state_name + fed_igr_share * log(n_govts),
data = reg_data)
anova(m7, m8)
tidy(m8, conf.int = TRUE) |>
filter(!str_starts(term, "state_name")) |>
mutate(across(where(is.numeric), \(x) round(x, 4)))
# Visualize with median split on n_govts
reg_data |>
mutate(
govts_group = if_else(n_govts >= median(n_govts),
"High # Govts (≥22)",
"Low # Govts (<22)")
) |>
ggplot(aes(x = fed_igr_share, y = log(PerCap_TaxBurden), color = govts_group)) +
geom_point(alpha = 0.4, size = 1.5) +
geom_smooth(method = "lm", se = TRUE) +
scale_x_continuous(labels = scales::percent_format()) +
labs(
x = "Federal IGR / Total Revenue",
y = "log(Tax Revenue per Capita)",
color = NULL,
title = "Federal IGR Effect on Tax Revenue by Number of Governments",
subtitle = "Non-metro western U.S. counties, 2012"
) +
theme(legend.position = "bottom")
reg_data |> select(contains("fed"), contains("direct"), contains("exp"), contains("pop")) |> names()
library(ggplot2)
ggplot(reg_data, aes(x = fed_share_pct, y = PerCap_Expenditures)) +
geom_point(alpha = 0.5) +
labs(
x = "Federal Land Share (%)",
y = "Direct Expenditures per Capita",
title = "Federal Land Share vs. Direct Expenditures per Capita"
)
reg_data |> select(contains("metro"), contains("rural"), contains("urban")) |> names()
reg_data |> count(metro)
data2 |> count(metro)
data2 |> select(contains("fed_share"), contains("PerCap"), contains("population")) |> names()
reg_data |> select(contains("ig"), contains("revenue"), contains("rev")) |> names()
reg_data |>
mutate(computed = R_IG_Fed / Total_Revenue) |>
select(fed_igr_share, computed) |>
head(5)
ggplot(reg_data, aes(x = fed_igr_share, y = PerCap_Expenditures)) +
geom_point(alpha = 0.5) +
labs(
x = "Fed IG Revenue / Total Revenue",
y = "Direct Expenditures per Capita",
title = "Direct Expenditures per Capita vs. Fed IG Revenue Share"
)
ggplot(reg_data, aes(x = fed_igr_share, y = PerCap_Expenditures)) +
geom_point(alpha = 0.5) +
scale_y_log10() +
labs(
x = "Fed IG Revenue / Total Revenue",
y = "Direct Expenditures per Capita (log scale)",
title = "Direct Expenditures per Capita vs. Fed IG Revenue Share"
)
ggplot(reg_data, aes(x = fed_share_pct, y = PerCap_Expenditures)) +
geom_point(alpha = 0.5) +
scale_y_log10() +
labs(
x = "Federal Land Share (%)",
y = "Direct Expenditures per Capita (log scale)",
title = "Direct Expenditures per Capita vs. Federal Land Share"
)
m_new <- lm(PerCap_Expenditures ~ fed_share_pct + fed_igr_share, data = reg_data)
broom::tidy(m_new, conf.int = TRUE)
broom::glance(m_new)
m_log <- lm(log(PerCap_Expenditures) ~ fed_share_pct + fed_igr_share, data = reg_data)
broom::tidy(m_log, conf.int = TRUE)
broom::glance(m_log)
reg_data |> select(contains("state"), contains("fips"), contains("county")) |> names()
m_fe <- lm(log(PerCap_Expenditures) ~ fed_share_pct + fed_igr_share + factor(state_code), data = reg_data)
broom::tidy(m_fe, conf.int = TRUE) |> filter(!str_starts(term, "factor"))
broom::glance(m_fe)
m_int <- lm(log(PerCap_Expenditures) ~ fed_share_pct * factor(state_code) + fed_igr_share, data = reg_data)
broom::glance(m_int)
# Extract just the interaction terms
broom::tidy(m_int, conf.int = TRUE) |>
filter(str_detect(term, "fed_share_pct:") | term == "fed_share_pct") |>
mutate(state = str_extract(term, "(?<=state_code\\)).*")) |>
select(state, estimate, std.error, statistic, p.value, conf.low, conf.high)
# F-test comparing fixed effects model vs. interaction model
anova(m_fe, m_int)
reg_data |> select(contains("gov")) |> names()
m_int2 <- lm(log(PerCap_Expenditures) ~ fed_share_pct * factor(state_code) + fed_igr_share + n_govts, data = reg_data)
broom::tidy(m_int2, conf.int = TRUE) |> filter(!str_starts(term, "factor"))
broom::glance(m_int2)
cor.test(reg_data$n_govts, reg_data$fed_share_pct)
names(reg_data)
names(m1$coefficients)
lapply(
list(m1=m1, m2=m2, m3=m3, m4=m4, m5=m5, m6=m6, m7=m7, m8=m8,
m_fe=m_fe, m_log=m_log, m_new=m_new, m_int=m_int, m_int2=m_int2),
function(m) formula(m)
)
library(broom)
library(dplyr)
library(ggplot2)
# Models to compare, with readable labels
model_list <- list(
"Tax Burden\n(basic)"          = m2,
"Tax Burden\n(+population)"    = m5,
"Tax Burden\n(+pop+n_govts)"   = m7,
"Expenditures\n(basic)"        = m_log,
"Expenditures\n(+state FE)"    = m_fe
)
# Tidy each model, keep only substantive predictors
coef_df <- purrr::imap_dfr(model_list, function(mod, label) {
tidy(mod, conf.int = TRUE) |>
filter(
!grepl("Intercept|state_name|state_code|factor", term)
) |>
mutate(model = label)
})
coef_df |>
mutate(
term = recode(term,
"fed_igr_share"       = "Fed IGR Share",
"fed_share_pct"       = "Fed Land Share (%)",
"log(population)"     = "log(Population)",
"log(n_govts)"        = "log(N Govts)"
),
model = factor(model, levels = names(model_list))
) |>
ggplot(aes(x = estimate, y = term, xmin = conf.low, xmax = conf.high,
color = model, shape = model)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "grey50") +
geom_errorbarh(height = 0.2, position = position_dodge(width = 0.6)) +
geom_point(size = 2.5, position = position_dodge(width = 0.6)) +
scale_color_brewer(palette = "Dark2") +
labs(
x = "Coefficient estimate (95% CI)",
y = NULL,
color = "Model",
shape = "Model",
title = "Coefficient Plot: Per Capita Tax Burden and Expenditures"
) +
theme_bw() +
theme(legend.position = "right")
head(reg_data)
summary(reg_data[c("PerCap_TaxBurden","PerCap_Expenditures","fed_igr_share","fed_share_pct","metro","RUCC_2013")])
